# Copy this file to .env.local and fill in your values
# Get these from your Supabase project → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Password to access the /admin page on web
EXPO_PUBLIC_ADMIN_PASSWORD=changeme

# Optional: bundle an Anthropic API key into the APK so users don't need to enter one.
# WARNING: this key will be extractable from the APK — use a dedicated key with a spend limit.
# If omitted, users must enter their own key in Settings.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
